  while :; do
    printf '\e[H\e[J\e[8;6H\e[1;33m%s\e[0m\n\n\e[6G%s\n\n' "$t_w" "$t_nav"
    
    for i in 0 1 2 3 4 5; do
      if (( i == s )); then
        printf '\e[6G\e[44;97m > %-26s\e[0m\n' "${menu_opt[$i]}"
      else
        printf '\e[6G   %-26s\n' "${menu_opt[$i]}"
      fi
      if [ -n "${menu_sub[$i]}" ]; then
        printf '\e[6G   %s\n\n' "${menu_sub[$i]}"
      else
        printf '\n'
      fi
    done
    
    printf '\e[2;1H%s' "$L"
    read -rsn3 k
    case $k in
      $'\e[A') ((s>0)) && ((s--)) ;;
      $'\e[B') ((s<5)) && ((s++)) ;;
      '') break ;;
    esac
  done

  case $s in
    0)
      dbus-run-session niri --session
      ;;
    1)
      sudo -E env XKB_DEFAULT_LAYOUT="${xkb_l:-fr}" QT_STYLE_OVERRIDE=kvantum cage calamares
      ;;
    2)
      printf '\e[32;1H%s\n\n' "$t_e"
      exit 0
      ;;
    3)
      setup_language
      ;;
    4)
