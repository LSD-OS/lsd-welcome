select_item() {
  local title="$1" arr_name="$2" w="$3"
  local -n items="$arr_name"
  local sel=0
  while :; do
    printf '\e[H\e[J\e[8;6H\e[1;33m%s\e[0m\n\n\e[6G%s\n\n' "$title" "$t_nav"
    local max_display=12 start=0
    if (( sel > max_display / 2 )); then start=$((sel - max_display / 2)); fi
    if (( start + max_display > ${#items[@]} )); then start=$((${#items[@]} - max_display)); fi
    if (( start < 0 )); then start=0; fi
    
    for i in $(seq $start $((start + max_display - 1))); do
      if (( i >= ${#items[@]} )); then break; fi
      local name="${items[$i]%%|*}"
      if (( i == sel )); then
        printf '\e[6G\e[44;97m > %-*s\e[0m\n' "$w" "$name"
      else
        printf '\e[6G   %-*s\n' "$w" "$name"
      fi
    done
    printf '\e[2;1H%s' "$L"
    read -rsn3 k
    case $k in
      $'\e[A') ((sel>0)) && ((sel--)) ;;
      $'\e[B') ((sel<${#items[@]}-1)) && ((sel++)) ;;
      '') break ;;
    esac
  done
  SELECTED_IDX=$sel
}

setup_language() {
  select_item "Select your language" langs 22
  lang_sel=$SELECTED_IDX
  selected_lang="${langs[$lang_sel]}"
  lang_code="${selected_lang#*|}"; lang_code="${lang_code%%|*}"
  locale_str="${selected_lang##*|}"

  echo "LANG=$locale_str" | sudo tee /etc/locale.conf > /dev/null
  echo "export LANG=$locale_str" | sudo tee /etc/profile.d/locale.sh > /dev/null
  export LANG="$locale_str"
  
  apply_translations
}

setup_keyboard() {
  select_item "Select your keyboard layout" keyboards 26
  kb_sel=$SELECTED_IDX
  selected_kb="${keyboards[$kb_sel]}"
  xkb_layout="${selected_kb##*|}"

  xkb_l="${xkb_layout%% *}"
  xkb_v=""
  [[ "$xkb_layout" == *" "* ]] && xkb_v="${xkb_layout#* }"

  case "$xkb_l" in
    br) vconsole_l="br-abnt2" ;;
    pt) vconsole_l="pt-latin1" ;;
    es) vconsole_l="es-latin1" ;;
    us) vconsole_l="us" ;;
    *)  vconsole_l="$xkb_l" ;;
  esac

  if [ -n "$xkb_v" ]; then
      Y_LAYOUT_SED='s/layout *"[^"]*"/layout "'$xkb_l'"\n            variant "'$xkb_v'"/'
  else
      Y_LAYOUT_SED='s/layout *"[^"]*"/layout "'$xkb_l'"/'
  fi

  files=(
    #"$HOME/.config/niri/cfg/input.kdl"
    #"$HOME/.config/thymbr/reset_config/niri/cfg/input.kdl"
    #"/etc/skel/.config/niri/cfg/input.kdl"
    #"/etc/skel/.config/thymbr/reset_config/niri/cfg/input.kdl"
    #"/etc/greetd/niri.kdl"
  )

  for f in "${files[@]}"; do
    dir=$(dirname "$f")
    if [ ! -d "$dir" ]; then
      sudo mkdir -p "$dir"
    fi
    
    if [ -f "$f" ]; then
      if [ -w "$f" ]; then
        sed -i "/variant/d" "$f"
        sed -i "$Y_LAYOUT_SED" "$f"
      else
        sudo sed -i "/variant/d" "$f"
        sudo sed -i "$Y_LAYOUT_SED" "$f"
      fi
    else
      if [ -w "$dir" ]; then
        printf 'input {\n    keyboard {\n        xkb {\n' > "$f"
        if [ -n "$xkb_v" ]; then
          printf '            layout "%s"\n            variant "%s"\n' "$xkb_l" "$xkb_v" >> "$f"
        else
          printf '            layout "%s"\n' "$xkb_l" >> "$f"
        fi
        printf '        }\n        numlock // Enable numlock on startup\n    }\n\n    touchpad {\n    tap\n    natural-scroll\n    accel-profile "adaptive"\n}\n}\n' >> "$f"
      else
        printf 'input {\n    keyboard {\n        xkb {\n' | sudo tee "$f" > /dev/null
        if [ -n "$xkb_v" ]; then
          printf '            layout "%s"\n            variant "%s"\n' "$xkb_l" "$xkb_v" | sudo tee -a "$f" > /dev/null
        else
          printf '            layout "%s"\n' "$xkb_l" | sudo tee -a "$f" > /dev/null
        fi
        printf '        }\n        numlock // Enable numlock on startup\n    }\n\n    touchpad {\n    tap\n    natural-scroll\n    accel-profile "adaptive"\n}\n}\n' | sudo tee -a "$f" > /dev/null
      fi
    fi
  done

  if [ -f /etc/vconsole.conf ]; then
      if grep -q "^KEYMAP=" /etc/vconsole.conf; then
          sudo sed -i -E "s/^KEYMAP=.*/KEYMAP=$vconsole_l/" /etc/vconsole.conf
      else
          echo "KEYMAP=$vconsole_l" | sudo tee -a /etc/vconsole.conf > /dev/null
      fi
  else
      echo "KEYMAP=$vconsole_l" | sudo tee /etc/vconsole.conf > /dev/null
  fi

  if [ -f /etc/conf.d/keymaps ]; then
      if grep -q "^[Kk]eymap=" /etc/conf.d/keymaps; then
          sudo sed -i -E "s/^[Kk]eymap=.*/keymap=\"$vconsole_l\"/" /etc/conf.d/keymaps
      else
          echo "keymap=\"$vconsole_l\"" | sudo tee -a /etc/conf.d/keymaps > /dev/null
      fi
  else
      echo "keymap=\"$vconsole_l\"" | sudo tee /etc/conf.d/keymaps > /dev/null
  fi

  sudo mkdir -p /etc/X11/xorg.conf.d
  printf 'Section "InputClass"\n    Identifier "system-keyboard"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "%s"\n    Option "XkbVariant" "%s"\nEndSection\n' "$xkb_l" "$xkb_v" | sudo tee /etc/X11/xorg.conf.d/00-keyboard.conf > /dev/null

  sudo tee /etc/calamares/modules/shellprocess.conf > /dev/null <<EOF
---
type: shellprocess
chroot: true
timeout: 300
script:
    - mkdir -p /etc/pam.d
    - echo session required pam_elogind.so >> /etc/pam.d/system-login
    - mkdir -p /etc/tmpfiles.d
    - mkdir -p /etc/scx
    - echo SCHEDULER=scx_lavd > /etc/scx/scheduler.conf
    - mkdir -p /run/user
    - chmod 0755 /run/user
    - rm /etc/conf.d/agetty.tty1
    - mv /etc/skel/.config/ironbar/config-post-install.toml /etc/skel/.config/ironbar/config.toml
    - rc-update add udev sysinit
    - rc-update add dbus default
    - rc-update add elogind default
    - rc-update add bluetoothd default
    - rc-update add NetworkManager default
    - rc-update add greetd default
    - rc-update add cupsd default
    - rc-update add chrony default
    - rc-update add plymouth-boot boot
    - rc-update add plymouth-shutdown shutdown
    - usermod -p '*' greeter
    - sed -i /variant/d /etc/greetd/niri.kdl
    - sed -i '$Y_LAYOUT_SED' /etc/greetd/niri.kdl
    - sed -i /variant/d /etc/skel/.config/niri/cfg/input.kdl
    - sed -i '$Y_LAYOUT_SED' /etc/skel/.config/niri/cfg/input.kdl
    - sed -i /variant/d /etc/skel/.config/thymbr/reset_config/niri/cfg/input.kdl
    - sed -i '$Y_LAYOUT_SED' /etc/skel/.config/thymbr/reset_config/niri/cfg/input.kdl
    - echo KEYMAP=$vconsole_l > /etc/vconsole.conf
    - echo 'keymap="'$vconsole_l'"' > /etc/conf.d/keymaps
    - grep -qw keymap /etc/mkinitcpio.conf || sed -i -E 's/^(HOOKS=\(.*)(filesystems|encrypt))/\1keymap \2/' /etc/mkinitcpio.conf
    - mkdir -p /etc/X11/xorg.conf.d
    - printf 'Section "InputClass"\n    Identifier "system-keyboard"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "'$xkb_l'"\n    Option "XkbVariant" "'$xkb_v'"\nEndSection\n' > /etc/X11/xorg.conf.d/00-keyboard.conf
    - ln -sf /usr/share/zoneinfo/${tz:-Europe/Paris} /etc/localtime
    - echo ${tz:-Europe/Paris} > /etc/timezone
    - ls /home | grep -v lost+found | xargs -r -I {} su - {} -c "xdg-user-dirs-update && xdg-user-dirs-gtk-update" || true
    - ls /usr/lib/modules | grep cachyos | head -1 | xargs -r -I {} cp /usr/lib/modules/{}/vmlinuz /boot/vmlinuz-linux-cachyos-lts
EOF

  sudo loadkeys "$vconsole_l" 2>/dev/null || true
}

setup_timezone() {
  tz_regions=()
  while IFS= read -r r; do
    tz_regions+=("$r")
  done < <(find /usr/share/zoneinfo -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | grep -vE '^(right|posix)$' | sort)

  select_item "Select your region" tz_regions 22
  local region="${tz_regions[$SELECTED_IDX]}"

  tz_cities=()
  while IFS= read -r c; do
    tz_cities+=("$c")
  done < <(find "/usr/share/zoneinfo/$region" -maxdepth 1 -type f -printf '%f\n' | sort)

  select_item "Select your city ($region)" tz_cities 26
  local city="${tz_cities[$SELECTED_IDX]}"

  tz="$region/$city"

  sudo ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
  echo "$tz" | sudo tee /etc/timezone > /dev/null

  if [ -f /etc/calamares/modules/shellprocess.conf ]; then
    if grep -q "zoneinfo" /etc/calamares/modules/shellprocess.conf; then
      sudo sed -i "s|/usr/share/zoneinfo/[^ ]*|/usr/share/zoneinfo/$tz|g" /etc/calamares/modules/shellprocess.conf
      sudo sed -i "s|echo [^ ]* > /etc/timezone|echo $tz > /etc/timezone|" /etc/calamares/modules/shellprocess.conf
    else
      sudo sed -i "s|    - ls /home|    - ln -sf /usr/share/zoneinfo/$tz /etc/localtime\n    - echo $tz > /etc/timezone\n    - ls /home|" /etc/calamares/modules/shellprocess.conf
    fi
  fi
}

if [ ! -f /tmp/.lsd_welcome_configured ]; then
  setup_language
  setup_keyboard
  setup_timezone
  touch /tmp/.lsd_welcome_configured
else
  if [ -f /etc/locale.conf ]; then
    current_locale=$(grep "^LANG=" /etc/locale.conf | cut -d= -f2 | tr -d '"')
    lang_code="${current_locale%%_*}"
  else
    lang_code="en"
  fi
  apply_translations
  
  if [ -f /etc/vconsole.conf ]; then
    xkb_l=$(grep "^KEYMAP=" /etc/vconsole.conf | cut -d= -f2 | tr -d '"')
    xkb_v=""
  else
    xkb_l="us"
  fi

  if [ -f /etc/timezone ]; then
    tz=$(cat /etc/timezone)
  elif [ -L /etc/localtime ]; then
    tz=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
  else
    tz="Europe/Paris"
  fi
fi

